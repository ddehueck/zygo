# ---- Config -----------------------------------------------------------------

src_dirs := "src tests examples"

# ---- Meta -------------------------------------------------------------------

# List available recipes
default:
    @just --list

# ---- Environment ------------------------------------------------------------

[group('environment')]
_install-dev:
    uv pip install -e .

# Initialize the virtual environment
[group('environment')]
init:
    uv venv
    uv sync
    source .venv/bin/activate
    uv pip install -e .

# ---- Formatting & Linting ---------------------------------------------------

# Format code with ruff
[group('lint')]
fmt:
    uvx ruff format {{ src_dirs }}

# Check formatting only
[group('lint')]
fmt-check:
    uvx ruff format --check {{ src_dirs }}

# Lint with ruff
[group('lint')]
lint:
    uvx ruff check {{ src_dirs }}

# Lint and auto-fix with ruff
[group('lint')]
lint-fix:
    uvx ruff check --fix {{ src_dirs }}

# Type-check with basedpyright
[group('lint')]
typecheck:
    uvx basedpyright {{ src_dirs }}

# Format and auto-fix all issues
[group('lint')]
fix: fmt lint-fix

# ---- CI-ish -----------------------------------------------------------------

# Run fmt-check + lint + typecheck (reports all failures)
[group('ci')]
check:
    #!/usr/bin/env bash
    exit_code=0
    echo "Running fmt-check..."
    just fmt-check || exit_code=1
    echo "Running lint..."
    just lint || exit_code=1
    echo "Running typecheck..."
    just typecheck || exit_code=1
    exit $exit_code

# Run tests with pytest
[group('ci')]
test:
    uv run pytest tests -v

# ---- Housekeeping -----------------------------------------------------------

# Remove caches
[group('housekeeping')]
clean:
    find . -type d -name __pycache__ -exec rm -rf {} +  2>/dev/null || true
    rm -rf .ruff_cache .pyright .ty_cache .mypy_cache .pytest_cache

# ---- Build ------------------------------------------------------------------

[group('build')]
build:
    uv build
